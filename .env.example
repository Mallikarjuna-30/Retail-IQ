# Database connection (SQLite default for local dev, MySQL supported for production)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js secret (generate using: openssl rand -base64 32)
AUTH_SECRET="retailiq_secret_key_change_in_production_32chars_min"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API key (server-side only, get from Google AI Studio)
GEMINI_API_KEY=""

# FastAPI AI Service connection
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_KEY="retailiq_ai_internal_secret_shared_key"

# App public configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

