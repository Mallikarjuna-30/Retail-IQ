# Database connection (SQLite default for local dev, MySQL supported for production)
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js secret (generate using: openssl rand -base64 32)
AUTH_SECRET="your_nextauth_secret_key_min_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API key (server-side only, get from Google AI Studio)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# FastAPI AI Service connection
AI_SERVICE_URL="http://127.0.0.1:8000"
AI_SERVICE_KEY="your_internal_ai_service_secret_key"

# App public configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

